    Text = "Asset ID",
    Default = "0",
    Callback = function(Value)
        bgData.Image = tostring(Value)
        applyBackground()
    end
})

BackGroup:AddButton({
    Text = "Clear Background",
    Callback = function()
        bgData.Image = "0"
        applyBackground()
    end
})


        end)
        V2.seatTask = task.spawn(function()
            while V2.active do
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChild("Humanoid")
                if hum and hum.SeatPart then
                    local seatParent = hum.SeatPart.Parent
                    if seatParent and (seatParent.Name == "Gucci" or seatParent.Name == "CreatureBlobman") then
                        local isOurGucci = false
                        local BackPack = Workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
                        if BackPack then
                            for _, v in pairs(BackPack:GetChildren()) do
                                if v == seatParent then isOurGucci = true break end
                            end
                        end
                        if isOurGucci then
                            Notify("Gucci v2", "Someone sat on your Gucci! Respawning...", 3)
                            pcall(function() ReplicatedStorage.MenuToys.DestroyToy:FireServer(seatParent) end)
                            task.wait(0.2)
                            if V2.active then
                                V2_Spawn()
                                Notify("Gucci v2", "Gucci v2 Restored!", 2)
                            end
                        end
                    end
                end
                task.wait(0.3)
            end
        end)
    end

    -- ═══════════════════════════════════════════════════════
    -- V3 — XOCU Gucci (gucciblob with type support)
    -- ═══════════════════════════════════════════════════════
    local V3 = {
        itm = nil, sp = nil, sv = nil, humconnection = nil,
        hum2 = nil, hrp2 = nil, running = false,
        inexistance = {}, charConn = nil,
    }
    V3.hum2, V3.hrp2 = getCharParts()

    local function V3_diddle()
        if V3.itm then
            for _, prt in pairs(V3.itm:GetChildren()) do
                if prt:IsA('BasePart') then prt.CanCollide = false end
            end
        end
        if V3.hrp2 then
            V3.hrp2.CFrame = V3.sp
            V3.hrp2.AssemblyLinearVelocity = V3.sv
        end
        if V3.hum2 then
            V3.hum2:GetPropertyChangedSignal('SeatPart'):Once(V3_diddle)
        end
    end

    local function V3_Stop()
        if V3.itm and V3.itm.Parent then
            task.spawn(function() pcall(function() DestroyToy:FireServer(V3.itm) end) end)
        end
        V3.itm = nil; V3.sp = nil; V3.sv = nil
        V3.humconnection = nil; V3.inexistance = {}
        V3.running = false
        if V3.charConn then V3.charConn:Disconnect() V3.charConn = nil end
    end

    local function V3_loop()
        if V3.running then return end
        V3.running = true
        local guccion = false
        local tickyticky = tick()
        local GUTYPE = G.Type

        while G.Enabled and G.Version == "v3" do
            V3.hum2, V3.hrp2 = getCharParts()
            if V3.hum2 and V3.hrp2 then
                local dt = tick() - tickyticky
                tickyticky = tick()

                if V3.itm and V3.itm:FindFirstChild('VehicleSeat') then
                    local occupant = V3.itm.VehicleSeat.Occupant
                    if occupant and occupant ~= V3.hum2 then
                        task.spawn(function() pcall(function() DestroyToy:FireServer(V3.itm) end) end)
                        V3.itm = nil; guccion = false; V3.inexistance = {}
                        task.wait(0.1)
                        if LocalPlayer.CanSpawnToy.Value then
                            task.spawn(function()
                                pcall(function() SpawnToy:InvokeServer(GUTYPE, V3.hrp2.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0,0,0)) end)
                            end)
                        end
                        task.wait()
                        continue
                    end
                end

                if V3.itm and V3.itm.Parent and not ((V3.itm:FindFirstChild('HumanoidRootPart') or V3.itm:FindFirstChild('SoundPart')) and V3.itm:FindFirstChild('VehicleSeat') and (not V3.itm.VehicleSeat.Occupant or V3.itm.VehicleSeat.Occupant ~= V3.hum2) or V3.inexistance[V3.itm] < 1) then
                    task.spawn(function() pcall(function() DestroyToy:FireServer(V3.itm) end) end)
                else
                    local toyFolder = workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
                    V3.itm = toyFolder and toyFolder:FindFirstChild(GUTYPE)
                end

                if not V3.sp or not V3.hum2.SeatPart then
                    V3.sp = V3.hrp2.CFrame
                    V3.sv = V3.hrp2.AssemblyLinearVelocity
                end

                if V3.humconnection ~= V3.hum2 then
                    V3.humconnection = V3.hum2
                    V3.hum2:GetPropertyChangedSignal('SeatPart'):Once(V3_diddle)
                end

                local waitFlag = true

                if V3.itm then
                    V3.inexistance[V3.itm] = (V3.inexistance[V3.itm] or 0) + dt

                    if (V3.itm:FindFirstChild('HumanoidRootPart') or V3.itm:FindFirstChild('SoundPart')) and V3.itm:FindFirstChild('VehicleSeat') and (not V3.itm.VehicleSeat.Occupant or V3.itm.VehicleSeat.Occupant == V3.hum2) then
                        if not guccion then
                            (V3.itm:FindFirstChild('HumanoidRootPart') or V3.itm:FindFirstChild('SoundPart')).AssemblyLinearVelocity = Vector3.new(0,0,0)
                        end

                        local diddy = V3.itm.VehicleSeat
                        diddy.Parent = nil
                        diddy.Parent = V3.itm

                        if (V3.hrp2.CFrame.Position - (V3.itm:FindFirstChild('HumanoidRootPart') or V3.itm:FindFirstChild('SoundPart')).CFrame.Position).Magnitude < 28 then
                            for _, prt in pairs(V3.itm:GetChildren()) do
                                if prt:IsA('BasePart') and prt.CanQuery then
                                    SetNetOwner:FireServer(prt, CFrame.lookAt(V3.hrp2.CFrame.Position, prt.CFrame.Position))
                                end
                            end
                        end

                        if not V3.hum2.SeatPart then
                            V3.hum2.Sit = false
                        else
                            waitFlag = false
                            task.wait()
                        end

                        if V3.hrp2 and V3.hum2 and (V3.itm:FindFirstChild('HumanoidRootPart') or V3.itm:FindFirstChild('SoundPart')) and V3.itm:FindFirstChild('VehicleSeat') and (not V3.itm.VehicleSeat.Occupant or V3.itm.VehicleSeat.Occupant == V3.hum2) then
                            local ragdolled = V3.hum2:FindFirstChild('Ragdolled')
                            if ragdolled and ragdolled.Value then guccion = false end

                            if V3.itm.VehicleSeat.Occupant == V3.hum2 then
                                guccion = true
                            elseif not guccion then
                                task.wait()
                                waitFlag = false
                                if (V3.itm:FindFirstChild('HumanoidRootPart') or V3.itm:FindFirstChild('SoundPart')) and V3.itm:FindFirstChild('VehicleSeat') and (not V3.itm.VehicleSeat.Occupant or V3.itm.VehicleSeat.Occupant == V3.hum2) then
                                    local ragdolled2 = V3.hum2:FindFirstChild('Ragdolled')
                                    if not ragdolled2 or not ragdolled2.Value then
                                        V3.itm.VehicleSeat:Sit(V3.hum2)
                                        Ragdoll:FireServer(V3.hrp2, 0.016)
                                    end
                                end
                            end

                            if guccion then
                                (V3.itm:FindFirstChild('HumanoidRootPart') or V3.itm:FindFirstChild('SoundPart')).AssemblyLinearVelocity = Vector3.new(0, 1e15, 0)
                            else
                                if V3.inexistance[V3.itm] >= game.Stats.Network.ServerStatsItem['Data Ping']:GetValue() / 250 then
                                    task.spawn(function() pcall(function() DestroyToy:FireServer(V3.itm) end) end)
                                    V3.hum2.Sit = true
                                end
                            end
                        end
                    else
                        if guccion then V3.hum2.Sit = true end
                        guccion = false
                        if V3.inexistance[V3.itm] >= 1 then
                            task.spawn(function() pcall(function() DestroyToy:FireServer(V3.itm) end) end)
                            if LocalPlayer.CanSpawnToy.Value then
                                task.spawn(function()
                                    pcall(function() SpawnToy:InvokeServer(GUTYPE, V3.hrp2.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0,0,0)) end)
                                end)
                            end
                        end
                    end
                else
                    if guccion then guccion = false V3.hum2.Sit = true end
                    if LocalPlayer.CanSpawnToy.Value then
                        task.spawn(function()
                            pcall(function() SpawnToy:InvokeServer(GUTYPE, V3.hrp2.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0,0,0)) end)
                        end)
                    end
                end

                if waitFlag then
                    task.wait()
                    V3.hum2.Sit = false
                end
            else
                task.wait()
            end
        end
        V3.running = false
    end

    local function V3_Start()
        V3_Stop()
        V3.charConn = LocalPlayer.CharacterAdded:Connect(function(c)
            if not G.Enabled or G.Version ~= "v3" then return end
            if V3.itm and V3.itm.Parent then
                task.spawn(function() pcall(function() DestroyToy:FireServer(V3.itm) end) end)
            end
            V3.itm = nil; V3.inexistance = {}; V3.humconnection = nil
            V3.sp = nil; V3.sv = nil; V3.running = false
            c:WaitForChild('Humanoid', 10)
            c:WaitForChild('HumanoidRootPart', 10)
            V3.hum2, V3.hrp2 = getCharParts()
            task.wait(0.5)
            task.spawn(V3_loop)
        end)
        task.spawn(V3_loop)
    end

    -- ═══════════════════════════════════════════════════════
    -- Controller (unified UI)
    -- ═══════════════════════════════════════════════════════
    local function StopAll()
        V1_Stop(); V2_Stop(); V3_Stop()
    end

    local function StartCurrent()
        if not G.Enabled then return end
        if G.Version == "v1" then V1_Start()
        elseif G.Version == "v2" then V2_Start()
        elseif G.Version == "v3" then V3_Start() end
    end

